# The name of the application displayed in the UI
VITE_APP_NAME=DocInt

# The current version of the frontend application
VITE_APP_VERSION=1.0.0

# The base URL of the backend API endpoints used for data fetching
VITE_API_BASE_URL=http://localhost:8000/api/v1

# The host URL for the backend API (used in specific detail/endpoint pages)
VITE_API_HOST=http://localhost:8000

# How often (in milliseconds) the frontend polls the backend for job status updates
VITE_POLLING_INTERVAL=2000

# The maximum number of times the frontend will poll for a job status before giving up
VITE_MAX_POLL_ATTEMPTS=120
