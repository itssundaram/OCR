# ─────────────────────────────────────────────────────────────────────────────
# DOCINT — Frontend environment (frontend/.env)
#
#   Copy this file to frontend/.env.   Vite reads it when `npm run dev` / `npm run build`
#   starts, so restart Vite after editing it. Only variables starting with VITE_ reach the browser.
#
#   The frontend reads exactly TWO variables. Both default to something that works when the
#   browser opens the app from the same machine that runs the API, so for a single-PC setup
#   this file can stay as it is.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API (must end with /api/v1, no trailing slash).
# All uploads, job polling, live streams and PDF/page images use this address.
#
#   Same PC (API on port 8000):         http://localhost:8000/api/v1
#   API on another machine:             http://<server-ip>:8000/api/v1
#   Behind a reverse proxy / `npm run build` served by the API machine's web server:
#                                       /api/v1     (relative; the proxy forwards /api to the API)
#
# Note: the browser, not the frontend server, calls this address. "localhost" therefore means the
# machine where the BROWSER runs. When users open the app from their own PCs, use the server's IP.
# If you change the API port, also change the proxy target in frontend/vite.config.js and the
# --port flag in start.bat / start.sh.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Address printed in the cURL examples on the "Generate URL / API" page.
# Set this to the address departments will actually call (the server's IP or host name), e.g.
# http://192.168.60.2:8000. Leave empty to use the current page address with port 5173 replaced by 8000.
VITE_API_HOST=http://localhost:8000
