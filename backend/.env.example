# ─────────────────────────────────────────────────────────────────────────────
# DOCINT — Backend Environment Configuration Template
# Copy this file to .env and fill in your actual local values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# The name of the application
APP_NAME=DocInt
# The environment type (development, staging, production)
APP_ENV=development
# The current version of the backend application
APP_VERSION=1.0.0

# ── API Server ────────────────────────────────────────────────────────────────
# The host address to bind the API server to (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0
# The port on which the API server will listen
API_PORT=8000

# ── Oracle Database ───────────────────────────────────────────────────────────
# Option A: Individual components (recommended for clarity)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=DATA_OCR
ORACLE_PASSWORD=oracle

# Option B: Full SQLAlchemy URL (overrides individual components if set)
# DATABASE_URL=oracle+oracledb://docint_user:your_password_here@localhost:1521/?service_name=FREEPDB1

# ── Redis ─────────────────────────────────────────────────────────────────────
# URL connection string for the Redis task queue
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory paths for storing documents, results, thumbnails, temp files, and logs
STORAGE_DIR=./data/documents
RESULTS_DIR=./data/results
THUMBNAILS_DIR=./data/thumbnails
TEMP_DIR=./data/temp
LOG_DIR=./data/logs

# ── OCR Configuration ─────────────────────────────────────────────────────────
# Strategy for OCR orchestrator: tesseract_only, surya, surya_with_fallback
OCR_STRATEGY=surya_with_fallback
SURYA_LAYOUT_ENABLED=true
SURYA_LAYOUT_CONFIDENCE_THRESHOLD=0.3
HANDWRITING_FALLBACK_ENABLED=true
HANDWRITING_FALLBACK_THRESHOLD=0.80
LLM_CLEANING_ENABLED=true
LLM_CLEANING_THRESHOLD=0.85
SURYA_DEVICE=cpu

# Forces huggingface to load models from cache and not ping the internet
HF_HUB_OFFLINE=1
# Turn OCR caching on/off to reuse stored OCR results on re-processing
ENABLE_OCR_CACHE=true

# ── AI Configuration ──────────────────────────────────────────────────────────
# Provider for the AI models (ollama or transformers)
AI_PROVIDER=ollama
# Model name to use for extraction (e.g., qwen2.5vl:3b, llama3.2-vision)
AI_MODEL=qwen2.5vl:3b
# The base URL of the local or remote Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
# Mode for payload sent to LLM: text | image | both
LLM_PAYLOAD_MODE=image

# LLM generation limits and context window configurations
LLM_MAX_OUTPUT_TOKENS=4096
OLLAMA_NUM_PREDICT=8192
OLLAMA_NUM_CTX=16384

# ── Direct LLM Call (Fast Path) ───────────────────────────────────────────────
# When True, skips Tesseract OCR and img2table entirely to save time.
# Images are sent directly to the Vision LLM. 
# Requires LLM_PAYLOAD_MODE=image or both. DO NOT use with LLM_PAYLOAD_MODE=text.
DIRECT_LLM_CALL=True

# ── Model storage (Phase: local CPU testing -> GPU server is a .env change) ──
# Base directory for all downloaded ML model weights (Surya/HuggingFace, and
# a reserved slot for the not-yet-built Paddle pipeline). Point this at local
# disk for CPU testing; point it at the GPU server's model cache path in
# production — nothing in the code needs to change either way.
MODEL_CACHE_DIR=./data/models
# Leave unset unless you need HuggingFace's cache somewhere other than
# MODEL_CACHE_DIR/huggingface (e.g. a pre-existing shared cache on the GPU box).
# HF_HOME_OVERRIDE=
# Reserved for the Paddle pipeline (not yet built).
# PADDLE_MODEL_DIR=

# ── Hardware ──────────────────────────────────────────────────────────────────
# Set to true if a GPU is available for use natively (not relevant if offloading to Ollama)
GPU_ENABLED=false
# The compute device to use locally: cpu | cuda | mps (Apple Silicon)
DEVICE=cpu

# ── Processing Limits ─────────────────────────────────────────────────────────
# Maximum allowed upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50
# Number of background workers for processing documents
WORKER_COUNT=1
# Number of pages from the start of a document to process. 0 = process all pages.
MAX_PAGES_TO_PROCESS=0

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum logging severity level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── External Tools ────────────────────────────────────────────────────────────
# Optional — Path to Tesseract executable (only needed if not in default system path)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Smart Extraction ──────────────────────────────────────────────────────────
# Threshold (0.0 to 1.0) for bypassing the LLM. If regex/matcher finds this % natively, LLM is skipped.
DIRECT_RESPONSE_THRESHOLD=0.75
